// ============================================================================
// Patel Car'spa & Detailing Studio - Master Prisma Schema for MySQL
// ============================================================================

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum Role {
  customer
  admin
}

enum BookingStatus {
  confirmed
  in_progress
  ready
  completed
  cancelled
}

enum DiscountType {
  FLAT
  PERCENTAGE
}

enum CoinTxType {
  earned
  redeemed
}

// ─── NEW ENUMS (Employee Panel) ─────────────────────────────

enum StaffStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  LATE
}

enum AttendanceMethod {
  QR
  MANUAL
}

enum PaymentMode {
  CASH
  UPI
  BANK
}

enum AdvanceStatus {
  OPEN
  CLOSED
}

// ─────────────────────────────────────────────────────────────
// EXISTING MODELS (Unchanged)
// ─────────────────────────────────────────────────────────────

model User {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  password         String
  phone            String
  role             Role              @default(customer)
  cleanCoins       Int               @default(0)
  referralCode     String            @unique
  referredBy       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  bookings         Booking[]
  coinTransactions CoinTransaction[]
  promoUsages      PromoCodeUsage[]

  @@index([email])
  @@index([phone])
  @@index([referralCode])
  @@map("users")
}

model Booking {
  id                     String            @id @default(cuid())
  bookingId              String            @unique
  userId                 String
  user                   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerName           String
  customerPhone          String
  customerEmail          String
  service                String
  plan                   String
  vehicleType            String
  vehicleNumber          String
  date                   String
  timeSlot               String
  address                String?           @db.Text
  notes                  String?           @db.Text
  basePrice              Float
  coinsUsed              Int               @default(0)
  discount               Float             @default(0)
  finalPrice             Float
  status                 BookingStatus     @default(confirmed)
  qrCode                 String?           @db.MediumText

  whatsappConfirmed      Boolean           @default(false)
  whatsappReady          Boolean           @default(false)
  whatsappReminder       Boolean           @default(false)

  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  coinTransactions       CoinTransaction[]
  promoCodeUsage         PromoCodeUsage?

  @@index([userId])
  @@index([bookingId])
  @@index([date, timeSlot])
  @@index([status])
  @@map("bookings")
}

model CoinTransaction {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       CoinTxType
  amount     Int
  reason     String
  bookingId  String?
  booking    Booking?   @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now())

  @@index([userId])
  @@index([bookingId])
  @@map("coin_transactions")
}

model PromoCode {
  id                 String            @id @default(cuid())
  code               String            @unique
  discountType       DiscountType      @default(FLAT)
  discountValue      Float
  minBookingAmount   Float?
  expiryDate         DateTime
  isActive           Boolean           @default(true)

  usageLimitPerUser  Int               @default(1)
  totalUsageLimit    Int?

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  usages             PromoCodeUsage[]

  @@index([code])
  @@index([isActive, expiryDate])
  @@map("promo_codes")
}

model PromoCodeUsage {
  id           String     @id @default(cuid())
  promoCodeId  String
  promoCodeRef PromoCode  @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  promoCode    String

  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName     String

  bookingId    String     @unique
  booking      Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingRef   String

  usedAt       DateTime   @default(now())

  @@index([promoCodeId, userId])
  @@index([userId])
  @@map("promo_code_usages")
}

// ─────────────────────────────────────────────────────────────
// NEW MODELS (Employee Panel)
// ─────────────────────────────────────────────────────────────

model Staff {
  id          String      @id @default(cuid())
  staffId     String      @unique          // EMP001, EMP002...
  name        String
  photo       String?     @db.LongText     // Base64 image (gallery upload)
  email       String      @unique          // NEW — Login ID
  mobile      String      @unique          // Login ID (alternative)
  password    String                       // bcrypt hashed (default = mobile)
  address     String?     @db.Text
  joiningDate DateTime
  role        String                       // Manager / Cashier / Helper / Salesman
  status      StaffStatus @default(ACTIVE)
  baseSalary  Float       @default(0)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  attendances Attendance[]
  salaries    Salary[]
  advances    Advance[]

  @@index([email])
  @@index([mobile])
  @@index([staffId])
  @@index([status])
  @@map("staff")
}

model Attendance {
  id          String             @id @default(cuid())
  staffId     String
  staff       Staff              @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date        DateTime           @db.Date
  inTime      DateTime?
  outTime     DateTime?
  status      AttendanceStatus   @default(PRESENT)
  method      AttendanceMethod   @default(QR)
  latitude    Float?
  longitude   Float?
  remark      String?            @db.Text

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([staffId, date])       // Ek din me ek hi attendance
  @@index([date])
  @@index([staffId])
  @@index([status])
  @@map("attendance")
}

model Salary {
  id           String       @id @default(cuid())
  staffId      String
  staff        Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  month        Int                          // 1-12
  year         Int                          // 2026
  baseSalary   Float
  presentDays  Int          @default(0)
  absentDays   Int          @default(0)
  advanceCut   Float        @default(0)
  deduction    Float        @default(0)
  bonus        Float        @default(0)
  finalSalary  Float
  paymentDate  DateTime?
  paymentMode  PaymentMode?
  isManual     Boolean      @default(false) // manual override flag
  remark       String?      @db.Text

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([staffId, month, year])  // Ek staff ki ek month me ek hi salary
  @@index([staffId])
  @@index([year, month])
  @@map("salary")
}

model Advance {
  id               String         @id @default(cuid())
  staffId          String
  staff            Staff          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  amountGiven      Float
  amountRecovered  Float          @default(0)
  remainingBalance Float
  reason           String?        @db.Text
  date             DateTime       @default(now())
  status           AdvanceStatus  @default(OPEN)

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([staffId])
  @@index([status])
  @@map("advances")
}

model AttendanceQR {
  id          String    @id @default(cuid())
  token       String    @unique
  isActive    Boolean   @default(true)
  expiresAt   DateTime
  expiresIn   Int                        // Kitne din ke liye banaya (record)
  createdBy   String?                    // Admin ID
  createdAt   DateTime  @default(now())

  @@index([token])
  @@index([isActive])
  @@index([expiresAt])
  @@map("attendance_qr")
}