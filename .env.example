# App Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=cleanpro_super_secure_jwt_secret_change_me_in_prod_123456789
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# WhatsApp Automation - UltraMsg API (Primary)
# Get credentials from: https://ultramsg.com
ULTRAMSG_INSTANCE_ID=instance12345
ULTRAMSG_TOKEN=your_ultramsg_token_here

# WhatsApp Cloud API (Fallback)
WHATSAPP_CLOUD_API_TOKEN=your_facebook_graph_api_token
WHATSAPP_CLOUD_PHONE_ID=your_whatsapp_phone_number_id

# Payments: Pay at Shop only (cash/UPI at counter). No online gateway.

# Nodemailer / Email Notifications (Optional OTP & Invoices)
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your_business_email@gmail.com
EMAIL_SERVER_PASSWORD=your_app_password
EMAIL_FROM="CleanPro Detailing <noreply@cleanpro.com>"

